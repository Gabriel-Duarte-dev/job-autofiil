{
    "manifest_version": 3,
    "name": "Job Autofill",
    "description": "Lê seu currículo e preenche formulários de candidatura em qualquer site.",
    "version": "1.0.0",
    "icons": {
        "16": "icon/16.png",
        "32": "icon/32.png",
        "48": "icon/48.png",
        "96": "icon/96.png",
        "128": "icon/128.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Job Autofill",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "options_ui": {
        "open_in_tab": true,
        "page": "options.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_idle",
            "js": [
                "content-scripts/content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content-scripts/content.css"
            ],
            "use_dynamic_url": true,
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}